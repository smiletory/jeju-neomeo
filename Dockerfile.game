FROM python:3.12-slim

RUN pip install --no-cache-dir uv==0.8.13

WORKDIR /code

COPY ./pyproject.toml ./README.md ./uv.lock* ./
COPY ./app ./app
COPY ./web ./web

RUN uv sync --frozen

ENV AGENT_EXECUTION_BACKEND=agent_runtime

EXPOSE 8080

CMD ["uv", "run", "uvicorn", "app.local_game_server:app", "--host", "0.0.0.0", "--port", "8080"]
