# Vertex AI Gemini
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=<GCP_PROJECT_ID>
GOOGLE_CLOUD_LOCATION=global

# Evidence retrieval: local_json or agent_platform_search
EVIDENCE_RETRIEVER_BACKEND=local_json

# Agent Platform Search values from the managed connector/Terraform outputs
DATA_STORE_REGION=global
DATA_STORE_COLLECTION=<DATA_STORE_COLLECTION>
DATA_STORE_ID=<DATA_STORE_ID>
DATA_STORE_SERVING_CONFIG=default_config
AGENT_SEARCH_TIMEOUT_SECONDS=10

# Desktop game execution: local or agent_runtime
AGENT_EXECUTION_BACKEND=local
AGENT_RUNTIME_ID=<AGENT_RUNTIME_RESOURCE_NAME>
AGENT_RUNTIME_REGION=us-east1
AGENT_RUNTIME_TIMEOUT_SECONDS=180
